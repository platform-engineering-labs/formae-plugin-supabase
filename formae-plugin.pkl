/*
 * formae plugin manifest — see https://docs.formae.io/plugin-sdk/
 */

name = "supabase"
version = "0.1.0"
namespace = "SUPABASE"
summary = "Supabase resource plugin for formae"
description = "Manages Supabase Management API resources (projects, branches, edge functions, secrets, api keys, configuration singletons) from formae forma files."
category = "data"
license = "FSL-1.1-ALv2"

// Minimum formae version. 'make build' raises this to the SDK floor but never
// downgrades below this declared value, so a schema feature that needs a newer
// formae (here formae.SecretValue, 0.88.0) keeps its gate.
minFormaeVersion = "0.88.0"

output {
  renderer = new JsonRenderer {}
}
