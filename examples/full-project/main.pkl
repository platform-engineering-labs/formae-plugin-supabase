//
// Full project from scratch — the whole plugin surface in one apply.
//
// Creates a Supabase Project (with nested auth / Data API / Postgres config),
// two API keys, an edge-function secret, and an edge function that reads it.
// Children reference the freshly created project via `project.res.id` — no
// pre-existing project, no second apply.
//
// The initial Postgres password is drawn by a formae PasswordGenerator: no
// plaintext in the forma, none in state, and nothing for you to supply. The
// generator carries no rotation cadence, so it draws once and never changes
// it — `dbPass` is createOnly, and rotating an immutable field would replace
// the project.
//
// The edge-function secret bag also shows the other half of the secrets
// story: `BACKEND_API_KEY` is not a literal but a reference to the secret
// API key created in this same apply (`secretKey.res.secretValue`). The agent
// re-reads that value from the Management API on every plugin call, so
// rotating the key out of band takes effect without an agent restart.
//
// Setup:
//   export SUPABASE_ACCESS_TOKEN=sbp_xxx
//   export SUPABASE_ORG_ID=<org slug or id>
//   export OPENAI_API_KEY=sk-...      # optional, demo fallback otherwise
//   formae apply --mode reconcile --watch examples/full-project/main.pkl
//
// Project create is async (~2 min to ACTIVE_HEALTHY); --watch shows progress.
// Free tier allows 2 projects per org. Tear down with:
//   formae destroy examples/full-project/main.pkl

amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@supabase/supabase.pkl"

local orgId     = read("env:SUPABASE_ORG_ID")
local openaiKey = read?("env:OPENAI_API_KEY") ?? "sk-demo-not-a-real-key"

forma {
  local appStack = new formae.Stack {
    label = "supabase-full-project"
    description = "Complete Supabase product stack from a single apply"
  }
  appStack

  new formae.Target {
    label = "supabase-target"
    config = new supabase.Config {}
  }

  // Draws the project's Postgres password. No rotation cadence: one draw,
  // reused on every later apply.
  local dbPassGen = new formae.PasswordGenerator {
    label = "demo-project-db-password"
    stack = appStack.res
    length = 24
  }
  dbPassGen

  // The project itself. Nested blocks PATCH the project's auth, Data API
  // (PostgREST), and Postgres settings right after creation.
  local project = new supabase.Project {
    label = "demo-project"
    name = "formae-full-demo"
    organizationId = orgId
    region = "us-east-1"
    // Bound to the generator above: formae draws the value and delivers it
    // here. Opaque, so it is hashed at rest and never rendered in a plan.
    dbPass = dbPassGen.gen.value
    plan = "free"
    auth = new supabase.ProjectAuthConfig {
      settings = new Mapping {
        ["site_url"] = "https://example.com"
      }
    }
    api = new supabase.ProjectAPIConfig {
      settings = new Mapping {
        ["max_rows"] = 1000
      }
    }
    database = new supabase.ProjectDatabaseConfig {
      settings = new Mapping {
        ["statement_timeout"] = "10s"
      }
    }
  }
  project

  // Browser-safe key for the web app.
  new supabase.APIKey {
    label = "publishable-key"
    projectRef = project.res.id
    apikey_type = "publishable"
    name = "frontend_publishable"
    description = "Browser-safe key for the web app"
  }

  // Server-side key for trusted services. A first-class secret resource: its
  // key material is reachable as `secretKey.res.secretValue`.
  local secretKey = new supabase.APIKey {
    label = "secret-key"
    projectRef = project.res.id
    apikey_type = "secret"
    name = "backend_secret"
    description = "Server-side key for trusted services"
  }
  secretKey

  // Edge-function secrets bag (one resource per project). Values are
  // write-only: the API never returns them, so formae cannot detect drift on
  // the values themselves.
  //
  // BACKEND_API_KEY is a reference, not a literal: formae resolves the secret
  // API key's value on apply and re-reads it live on every later plugin call.
  new supabase.Secrets {
    label = "edge-secrets"
    projectRef = project.res.id
    values {
      ["OPENAI_API_KEY"]  = openaiKey
      ["BACKEND_API_KEY"] = secretKey.res.secretValue
    }
  }

  // Edge function that proves the secret is wired through.
  new supabase.EdgeFunction {
    label = "ask-ai"
    projectRef = project.res.id
    slug = "ask-ai"
    name = "Ask AI"
    verify_jwt = true
    body = """
      Deno.serve(() => {
        const key = Deno.env.get("OPENAI_API_KEY") ?? "unset"
        const backend = Deno.env.get("BACKEND_API_KEY") ?? "unset"
        return new Response(
          JSON.stringify({
            openaiKeyPrefix: key.slice(0, 7),
            backendKeyWired: backend !== "unset",
          }),
          { headers: { "Content-Type": "application/json" } },
        )
      })
      """
  }
}
