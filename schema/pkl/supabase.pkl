/// Supabase Management API resource definitions.
///
/// Only resources implemented in the plugin appear here.
module supabase

import "@formae/formae.pkl"

// =============================================================================
// Target configuration
// =============================================================================

/// Deployment-level config for a Supabase target.
///
/// Credentials live in environment variables (SUPABASE_ACCESS_TOKEN), never
/// in the forma — same pattern as formae-plugin-sftp.
open class Config {
    hidden fixed type: String = "SUPABASE"

    /// Override base URL. Defaults to https://api.supabase.com.
    baseUrl: String? = null

    /// Advanced / conformance-only. Scopes sub-resource `List()` and
    /// discovery (Branch, APIKey, EdgeFunction, Secret) to a single
    /// Supabase project. Leave unset in normal use — discovery then walks
    /// every project the PAT can see. The conformance suite sets it to
    /// keep sub-resource discovery within the harness's 2-minute window;
    /// production targets should omit it. Project discovery is always
    /// global regardless of this field.
    projectRef: String? = null

    fixed Type: String = type
    fixed BaseUrl: String? = baseUrl
    fixed ProjectRef: String? = projectRef
}

// =============================================================================
// SUPABASE::Platform::Project
// =============================================================================

/// Resolvable handle for `SUPABASE::Platform::Project` outputs. Reference
/// these from child resources to wire a freshly created project into its
/// branches, keys, functions, and secrets in the same apply, e.g.
///   projectRef = project.res.id
open class ProjectResolvable extends formae.Resolvable {
    hidden type = "SUPABASE::Platform::Project"

    hidden id:   ProjectResolvable = (this) { property = "id" }
    hidden name: ProjectResolvable = (this) { property = "name" }
}

/// A Supabase project. Maps to POST /v1/projects.
///
/// Project create is async; the plugin waits for ACTIVE_HEALTHY via Status().
@formae.ResourceHint {
    type = "SUPABASE::Platform::Project"
    identifier = "$.id"
    discoverable = true
}
class Project extends formae.Resource {
    fixed hidden type: String = "SUPABASE::Platform::Project"

    local parent = this
    hidden res: ProjectResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// Project display name.
    @formae.FieldHint { requiredOnCreate = true }
    name: String

    /// Organization slug or id that owns the project.
    /// Immutable after creation.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    organizationId: String

    /// AWS region (e.g. "us-east-1", "eu-west-1").
    /// Immutable after creation.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    region: String

    /// Initial Postgres password. >= 8 chars.
    /// Send-only — never returned by the API. Declared nullable on purpose:
    /// the schema extractor marks every non-nullable, no-default field as
    /// `Required`, and discovery rejects any resource whose `Required` fields
    /// aren't present in the Read response. Since the API never echoes the
    /// password, a non-nullable `dbPass` makes every existing project
    /// undiscoverable. Create() enforces presence in Go instead.
    ///
    /// Accepts anything formae can supply a value from: a literal, a recorded
    /// `formae.Value`, a reference to another resource's secret
    /// (`secret.res.secretValue`), or a generator output
    /// (`pwGen.gen.value` from a `formae.PasswordGenerator`). Binding a
    /// generator without a `rotation` draws the password once and never
    /// changes it — the replacement for minting one at eval time and pinning
    /// it with `setOnce`. Formae resolves the binding to a plain string
    /// before the plugin sees it.
    ///
    /// Naming `formae.ValueSource` is also what marks the field opaque, so it
    /// is hashed at rest and never rendered in a plan however the author
    /// supplied it — the schema builder derives `Opaque` from the declared
    /// type and ignores an authored `opaque` hint. `createOnly`, so do not
    /// attach a rotation cadence to a generator bound here: rotating an
    /// immutable field would replace the project.
    @formae.FieldHint {
        createOnly = true
        writeOnly = true
    }
    dbPass: (String|formae.ValueSource)?

    /// Pricing plan ("free", "pro", "team", "enterprise").
    @formae.FieldHint {}
    plan: String? = "free"

    /// Compute instance size (e.g. "micro", "small", "medium").
    @formae.FieldHint {}
    desiredInstanceSize: String? = null

    /// Auth configuration block (PATCHes /v1/projects/{ref}/config/auth
    /// when set). Plugin tracks managed keys so unmanaged cloud fields
    /// don't surface as drift.
    @formae.FieldHint {}
    auth: ProjectAuthConfig? = null

    /// PostgREST (Data API) configuration block. PATCHes
    /// /v1/projects/{ref}/postgrest when set.
    @formae.FieldHint {}
    api: ProjectAPIConfig? = null

    /// Postgres database tuning block. PUTs
    /// /v1/projects/{ref}/config/database/postgres when set.
    @formae.FieldHint {}
    database: ProjectDatabaseConfig? = null

    /// Network CIDR allow-list block. PATCHes
    /// /v1/projects/{ref}/network-restrictions when set.
    @formae.FieldHint {}
    networkRestriction: ProjectNetworkRestriction? = null
}

/// Auth config payload. Settings is opaque JSON matching
/// UpdateAuthConfigBody in the Supabase Management API.
class ProjectAuthConfig {
    settings: Mapping<String, Any>?
}

/// PostgREST config payload. Settings keys: db_schema, db_extra_search_path,
/// max_rows, db_pool, ...
class ProjectAPIConfig {
    settings: Mapping<String, Any>?
}

/// Postgres config payload. Settings keys: max_connections, shared_buffers,
/// work_mem, ...
class ProjectDatabaseConfig {
    settings: Mapping<String, Any>?
}

/// Network restriction payload. Settings shape:
/// { "dbAllowedCidrs": [...], "dbAllowedCidrsV6": [...] }.
class ProjectNetworkRestriction {
    settings: Mapping<String, Any>?
}

// =============================================================================
// SUPABASE::Platform::Branch
// =============================================================================

/// A preview branch on a Supabase project.
/// Async — plugin polls until status reaches FUNCTIONS_DEPLOYED / MIGRATIONS_PASSED.
@formae.ResourceHint {
    type = "SUPABASE::Platform::Branch"
    identifier = "$.id"
    discoverable = true
}
class Branch extends formae.Resource {
    fixed hidden type: String = "SUPABASE::Platform::Branch"

    /// Parent project reference. Immutable after creation.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    parentProjectRef: String|formae.Resolvable

    /// Branch name.
    @formae.FieldHint { requiredOnCreate = true }
    branch_name: String

    /// Optional Git branch name to track.
    @formae.FieldHint {}
    git_branch: String?

    /// Whether the branch is persistent.
    @formae.FieldHint {}
    persistent: Boolean? = false

    /// Region for the branch's database. Immutable.
    @formae.FieldHint { createOnly = true }
    region: String?

    /// Compute instance size for the branch.
    @formae.FieldHint { createOnly = true }
    desired_instance_size: String?
}

// =============================================================================
// SUPABASE::Auth::APIKey
// =============================================================================

/// Resolvable handle for `SUPABASE::Auth::APIKey` outputs. Reference
/// these from other resources to wire credentials across plugins, e.g.
///   stringData["NEXT_PUBLIC_SUPABASE_ANON_KEY"] = anonKey.res.apiKey
open class APIKeyResolvable extends formae.ScalarSecretResolvable {
    hidden type = "SUPABASE::Auth::APIKey"

    /// The key material is a scalar secret, so `key.res.secretValue` (and
    /// `.json(path)` for a JSON-shaped key) resolve against `apiKey`.
    hidden valueProperty = "apiKey"

    hidden id:     APIKeyResolvable = (this) { property = "id" }
    hidden apiKey: APIKeyResolvable = (this) { property = "apiKey" }
    hidden prefix: APIKeyResolvable = (this) { property = "prefix" }
}

/// Project-scoped API key (publishable or secret).
@formae.ResourceHint {
    type = "SUPABASE::Auth::APIKey"
    identifier = "$.id"
    discoverable = true
}
class APIKey extends formae.Secret {
    fixed hidden type: String = "SUPABASE::Auth::APIKey"

    /// The secret value of this resource is its key material. Consumers
    /// reference it as `key.res.secretValue`; the agent re-reads it from the
    /// Management API on every plugin call, so a key rotated out of band
    /// takes effect without restarting the agent.
    hidden valueProperty = "apiKey"

    local parent = this
    hidden res: APIKeyResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// Parent project reference. Immutable.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    projectRef: String|formae.Resolvable

    /// "publishable" or "secret". Immutable.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    apikey_type: String

    /// Short key name (lowercase, snake_case, 4–64 chars).
    @formae.FieldHint { requiredOnCreate = true }
    name: String

    /// Optional description.
    @formae.FieldHint {}
    description: String?

    /// The key material, issued by Supabase — never authored. Declared so the
    /// property carries a hint at all: the schema builder derives `Opaque`
    /// from the declared type, so naming `formae.SecretValue` in the union is
    /// what makes the agent hash the key at rest and keep it out of plans (an
    /// authored `opaque` hint is overwritten). `hasProviderDefault` keeps the
    /// provider-populated value from reading as drift against a forma that
    /// correctly does not set it. `Read` returns it on every call via
    /// `?reveal=true`, which is what makes `key.res.secretValue` resolve live.
    @formae.FieldHint {
        hasProviderDefault = true
    }
    apiKey: (String|formae.SecretValue)?
}

// =============================================================================
// SUPABASE::Functions::EdgeFunction
// =============================================================================

/// A Supabase Edge Function deployed from an inline body.
@formae.ResourceHint {
    type = "SUPABASE::Functions::EdgeFunction"
    identifier = "$.slug"
    discoverable = true
}
class EdgeFunction extends formae.Resource {
    fixed hidden type: String = "SUPABASE::Functions::EdgeFunction"

    /// Parent project. Immutable.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    projectRef: String|formae.Resolvable

    /// URL-safe slug. Immutable.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    slug: String

    /// Display name.
    @formae.FieldHint { requiredOnCreate = true }
    name: String

    /// Inline TypeScript/JavaScript source body (Deno). Nullable on purpose:
    /// the extractor marks non-nullable, no-default fields as `Required`, and
    /// the API never returns the source on Read, so a non-nullable `body`
    /// makes existing functions undiscoverable. Create() enforces presence.
    @formae.FieldHint {}
    body: String?

    /// Whether to verify the JWT before invocation.
    @formae.FieldHint {}
    verify_jwt: Boolean? = true
}

// =============================================================================
// SUPABASE::Functions::Secrets
// =============================================================================

/// All Edge Function secrets for a project, as one resource.
///
/// The Supabase secrets endpoint is a single bulk bag per project — there is
/// no per-secret API. Modelling the whole bag as one resource means every
/// mutation is a single atomic bulk call, which avoids the lost-update race
/// that per-secret resources hit when applied concurrently (each concurrent
/// single-item write does a read-modify-write on the shared bag and the last
/// writer wins). One Secrets resource per project; identifier is the project
/// ref.
@formae.ResourceHint {
    type = "SUPABASE::Functions::Secrets"
    identifier = "$.projectRef"
    discoverable = true
}
class Secrets extends formae.Resource {
    fixed hidden type: String = "SUPABASE::Functions::Secrets"

    /// Parent project. Immutable.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    projectRef: String|formae.Resolvable

    /// Secret name → value map. Names must not start with SUPABASE_ (reserved
    /// by the platform). Values are send-only — never returned by the API, so
    /// drift on a value cannot be detected. Nullable on purpose: the extractor
    /// marks non-nullable, no-default fields as `Required`, and discovery
    /// rejects resources whose `Required` fields are absent from Read. Since
    /// the API never echoes values, a non-nullable `values` makes existing
    /// secret bags undiscoverable. Create() enforces presence in Go.
    ///
    /// Each entry accepts anything formae can supply a value from, so an entry
    /// can be a generator output (`whGen.gen.value`) or a reference to another
    /// resource's secret (`key.res.secretValue`) instead of a literal. Bag
    /// entries are mutable, so a generator bound here may carry a `rotation`
    /// cadence: formae then moves the secret and everything referencing it
    /// together, unattended.
    ///
    /// Not opaque, and it cannot be: `Opaque` is derived from the declared
    /// type, and formae 0.89.0's detector does not descend into map value
    /// positions ("Nested/list/map positions are deferred — first cut only"),
    /// so entry values are stored unhashed in agent state. `writeOnly` keeps
    /// them out of drift detection but is not hashing. Prefer binding entries
    /// to a generator or a secret reference over pasting literals here.
    @formae.FieldHint {
        writeOnly = true
    }
    values: Mapping<String, (String|formae.ValueSource)>?
}

